<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.SettingsDialog">
        <Dialog title="title">
            <ul class="list-unstyled">
                <li t-foreach="props.items" t-as="item" t-key="item.id" class="form-check">
                    <input type="checkbox"
                           class="form-check-input"
                           t-att-id="'dashboard_item_' + item.id"
                           t-att-checked="state.checked[item.id]"
                           t-on-change="() => this.toggle(item.id)"/>
                    <label class="form-check-label" t-att-for="'dashboard_item_' + item.id">
                        <t t-esc="item.description || item.id"/>
                    </label>
                </li>
            </ul>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onApply">Apply</button>
            </t>
        </Dialog>
    </t>
</templates>
